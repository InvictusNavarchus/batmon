    "uninstall-service": "./uninstall.sh"
  },
  "keywords": ["battery", "linux", "monitoring", "sqlite", "upower", "health"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.14"
  }
}