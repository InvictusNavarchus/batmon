{
	"name": "batmon",
	"version": "0.5.0",
	"description": "Battery health monitor & flight recorder → SQLite. Logs 1s debug telemetry and 60s historical data via systemd daemon.",
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"format": "biome format --write --no-errors-on-unmatched",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"install-service": "./install.sh",
		"uninstall-service": "./uninstall.sh",
		"knip": "knip",
		"release": "release-it"
	},
	"keywords": [
		"battery",
		"linux",
		"monitoring",
		"sqlite",
		"upower",
		"health"
	],
	"license": "UNLICENSED",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"knip": "^6.32.3",
		"lefthook": "^2.1.10",
		"release-it": "^21.0.2",
		"typescript": "^7.0.2"
	}
}
