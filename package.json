{
	"name": "batmon",
	"version": "0.2.0",
	"description": "Battery health monitor & flight recorder → SQLite. Logs 1s debug telemetry and 60s historical data via systemd daemon.",
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"install-service": "./install.sh",
		"uninstall-service": "./uninstall.sh"
	},
	"keywords": [
		"battery",
		"linux",
		"monitoring",
		"sqlite",
		"upower",
		"health"
	],
	"license": "UNLICENSED",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "^1.4.0"
	}
}
